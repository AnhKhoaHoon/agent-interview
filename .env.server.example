# Copy to .env.server on the Linux server. Keep this file uncommitted.
NODE_ENV=production
PORT=3000
BACKEND_HOST_PORT=3000

# PostgreSQL remains inside the Compose network. URL-encode reserved characters
# in the password in DATABASE_URL while POSTGRES_PASSWORD stays raw.
POSTGRES_DB=agent_interview
POSTGRES_USER=agent_interview
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://agent_interview:replace-with-url-encoded-password@postgres:5432/agent_interview
REDIS_URL=redis://redis:6379

LLM_PROVIDER=openai
LLM_API_KEY=replace-with-backend-only-key
LLM_MODEL=gpt-6.1-sol
LLM_TIMEOUT_MS=15000
LLM_MAX_RETRIES=2
# Tune only after measuring representative interview questions. These values
# favor fast, concise spoken answers while keeping a reasoning pass.
LLM_REASONING_EFFORT=low
LLM_MAX_OUTPUT_TOKENS=600
LLM_VERBOSITY=low
# Enable the routine path only after a representative quality/latency benchmark.
LLM_ROUTINE_MODEL=gpt-6-luna
LLM_ROUTINE_REASONING_EFFORT=low
LLM_ROUTINE_MAX_OUTPUT_TOKENS=320
LLM_ROUTINE_VERBOSITY=low

RAG_ENABLED=true
KNOWLEDGE_DIRECTORY=/app/knowledge
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_TIMEOUT_MS=10000
EMBEDDING_MAX_RETRIES=2
RAG_MAX_CHUNKS=4
RAG_MIN_SIMILARITY=0.72
RAG_MIN_KEYWORD_COVERAGE=0.35

STT_PROVIDER=openai
STT_API_KEY=replace-with-backend-only-key
STT_MODEL=gpt-transcribe
STT_LANGUAGE=en
STT_TIMEOUT_MS=20000
STT_MAX_RETRIES=2
STT_MAX_AUDIO_BYTES=10485760
STT_MAX_DURATION_MS=31000

CANDIDATE_CONTEXT_MAX_BYTES=2097152
CANDIDATE_CONTEXT_MAX_CHARACTERS=30000
CANDIDATE_CONTEXT_PROMPT_MAX_CHARACTERS=8000

# Set the exact published Chrome extension origin. Do not use a wildcard.
CORS_ORIGINS=chrome-extension://YOUR_EXTENSION_ID
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_CREATE_MAX=10
RATE_LIMIT_TRANSCRIPTION_MAX=20
RATE_LIMIT_DEFAULT_MAX=120
TRUST_PROXY_HOPS=1
SWAGGER_ENABLED=false
METRICS_ENABLED=true
METRICS_BEARER_TOKEN=replace-with-a-long-random-token
LOG_LEVEL=info
