NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/agent_interview
REDIS_URL=redis://redis:6379

LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-5
LLM_TIMEOUT_MS=15000
LLM_MAX_RETRIES=2

# Phase 10 DevOps knowledge RAG. This credential is backend-only; when blank,
# EMBEDDING_API_KEY falls back to LLM_API_KEY.
RAG_ENABLED=true
KNOWLEDGE_DIRECTORY=/app/knowledge
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_TIMEOUT_MS=10000
EMBEDDING_MAX_RETRIES=2
RAG_MAX_CHUNKS=4
RAG_MIN_SIMILARITY=0.72
# Minimum lexical-keyword coverage that can rescue an otherwise weak semantic match.
RAG_MIN_KEYWORD_COVERAGE=0.35

# Phase 11 personal CV and Job Description context. Raw files are discarded;
# normalized extracted text is stored per interview and bounded before prompting.
CANDIDATE_CONTEXT_MAX_BYTES=2097152
CANDIDATE_CONTEXT_MAX_CHARACTERS=30000
CANDIDATE_CONTEXT_PROMPT_MAX_CHARACTERS=8000

STT_PROVIDER=openai
STT_API_KEY=
# Quality-first transcription. gpt-transcribe supports DevOps keywords; it can cost more than mini models.
STT_MODEL=gpt-transcribe
# Fallback only when a client omits its language hint. V1 supports vi/en.
STT_LANGUAGE=en
STT_TIMEOUT_MS=20000
STT_MAX_RETRIES=2
STT_MAX_AUDIO_BYTES=10485760
STT_MAX_DURATION_MS=31000

CORS_ORIGINS=http://localhost:5173,chrome-extension://YOUR_EXTENSION_ID
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_CREATE_MAX=10
RATE_LIMIT_TRANSCRIPTION_MAX=20
RATE_LIMIT_DEFAULT_MAX=120
TRUST_PROXY_HOPS=0
SWAGGER_ENABLED=true
METRICS_ENABLED=false
METRICS_BEARER_TOKEN=
LOG_LEVEL=info
